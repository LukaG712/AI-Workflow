# Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Prompt refinement — when enabled, Ollama rewrites prompts before sending to Junie
# Default: false (sends raw prompt directly to Junie, no Ollama needed)
REFINE_PROMPT=false

# Workspace path — where Junie does project work, stores MEMORY.md and session logs
# Optional — falls back to a temp directory if not set
WORKSPACE_PATH=~/workspace

# Obsidian vault path — your searchable notes and knowledge (read-only background)
# Optional — set only if you want Obsidian integration
# VAULT_PATH=/path/to/obsidian/vault

# Optional vault map file path (helps prompt builder understand your vault)
# VAULT_MAP_PATH=vault_map.md

# Mirror session logs to VAULT_PATH/Session-Logs/ for Obsidian visibility
# Requires VAULT_PATH to be set
MIRROR_LOGS_TO_VAULT=false

# API key for Bearer token authentication (required for HTTP service)
API_KEY=your-secret-key-here

# Junie CLI timeout in seconds
JUNIE_TIMEOUT=1800

# Port for uvicorn HTTP service
PORT=8000

# Override Junie binary path (for testing only)
# JUNIE_BIN=tests/fake_junie.py
