# Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Obsidian vault path (mount your NAS share here)
VAULT_PATH=/mnt/vault

# Optional vault map file path (helps prompt builder understand your vault)
# VAULT_MAP_PATH=vault_map.md

# API key for Bearer token authentication (change this!)
API_KEY=your-secret-key-here

# Junie CLI timeout in seconds
JUNIE_TIMEOUT=1800

# Port for uvicorn
PORT=8000

# Override Junie binary path (for testing only)
# JUNIE_BIN=tests/fake_junie
